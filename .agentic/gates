#!/usr/bin/env bash
# The full local gate set: the same steps, in the same order, as .github/workflows/ci.yml,
# so green here means green in CI. Run from anywhere; stops at the first failure.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

step() { printf '\n== %s\n' "$1"; }

step "dependencies (uv sync --locked)"; uv sync --locked
step "lint (ruff)";          uv run ruff check
step "format (ruff)";        uv run ruff format --check
step "types (mypy, strict)"; uv run mypy
step "tests (pytest)";       uv run pytest
# CI starts from an empty warehouse; raw.api_responses is append-only, so a leftover
# ci.duckdb would build on stale rows.
rm -f dbt/ci.duckdb dbt/ci.duckdb.wal
step "fixture warehouse";    uv run front-office load --raw-root fixtures/landing --db dbt/ci.duckdb
(
  cd dbt
  export DBT_PROFILES_DIR=.
  step "dbt deps";                       uv run dbt deps
  step "dbt build (fixtures, anonymised)"; uv run dbt build --target ci --vars '{anonymize: true}'
)
# Two leagues by two seasons, built together and each alone: every model must give a
# league-season the same rows either way (spec 0028, ADR 0013).
step "tenant isolation (4 league-seasons)"; uv run python scripts/check_tenant_isolation.py
printf '\nAll gates passed.\n'
