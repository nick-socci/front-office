# The production image: the Dagster code server, daemon and UI for the daily run (spec 0218, ADRs
# 0133 and 0138), and the dashboard (spec 0232).
#
# One image, four containers: the unit files in deploy/quadlet/ start `dagster api grpc`,
# `dagster-daemon run`, `dagster-webserver` and `streamlit run` from it. It holds the code and dbt's
# project at the commit it is built from (the `GIT_COMMIT` build argument becomes a label and
# `FO_GIT_COMMIT`, which `extract-marts` records), and no credential: the units mount the ESPN
# `.env` and the Google key read-only at run time into the code server alone (rule 3), the dashboard
# gets none, and `.containerignore` at the repository root keeps them out of the build context.
#
# Build, always from the repository root (the runbook says the same):
#   podman build -f deploy/Containerfile --build-arg GIT_COMMIT=$(git rev-parse HEAD) \
#       -t localhost/front-office:$(git rev-parse --short HEAD) .
#
# It runs as the container's root, which rootless Podman maps to the host user `front-office`:
# the bind-mounted landing zone is that user's, and a second container user could not write it.
FROM docker.io/library/python:3.13-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /usr/local/bin/uv

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PATH=/app/.venv/bin:$PATH \
    DAGSTER_HOME=/dagster_home \
    DBT_PROFILES_DIR=/app/dbt

WORKDIR /app

# The locked dependencies first, so a code change does not reinstall them. No default groups:
# the dev group (sqlfluff, scipy, dbt-duckdb) is not needed by a BigQuery run.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-default-groups --group orchestration --group bigquery --group dashboard --no-install-project

# The code, then the project itself (editable, so the CLI finds /app/.env from its own source).
COPY . .
RUN uv sync --locked --no-default-groups --group orchestration --group bigquery --group dashboard

# dbt's packages at build time: the code location parses dbt when it loads (0217).
RUN cd dbt && dbt deps

RUN mkdir -p /dagster_home && chmod +x /app/deploy/entrypoint.sh

ARG GIT_COMMIT=unknown
ENV FO_GIT_COMMIT=$GIT_COMMIT
LABEL org.opencontainers.image.revision=$GIT_COMMIT \
      org.opencontainers.image.source="https://github.com/nick-socci/front-office"

# The build fails if the dashboard is not in the image (its directory excluded, its group not
# installed, or its marts YAML, which gives the column tooltips, missing). `app.py` itself is not
# imported: it runs Streamlit calls at import.
RUN cd /app/dashboard && python -c "import front_office_dashboard.data, front_office_dashboard.labels as l; assert l.MARTS_YAML.is_file(), l.MARTS_YAML"

# The entrypoint puts the image's own dagster.yaml in the instance directory, so the instance's
# settings follow the commit that was built; the volume holds the history.
ENTRYPOINT ["/app/deploy/entrypoint.sh"]
CMD ["dagster-daemon", "run", "-w", "/app/deploy/workspace.yaml"]
