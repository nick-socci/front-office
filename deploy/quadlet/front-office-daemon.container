# Dagster's daemon on `mothership` (spec 0218, ADR 0133): it holds the schedules, launches each run
# as a subprocess, and is the only container that sees the ESPN cookies and the Google key.
#
# Install as the `front-office` user: copy to ~/.config/containers/systemd/, then
# `systemctl --user daemon-reload && systemctl --user start front-office-daemon`.
# Podman 4.9's Quadlet has no `Memory=` and no pods (spec C19), so the limit is `PodmanArgs`, and
# the container's directory is `WorkingDir` (not systemd's `WorkingDirectory`). The working
# directory holds no `.env`: Dagster loads the one in its own directory over its environment
# (0217 Amendments, 2026-11-16); the CLI finds /app/.env itself.
#
# Host layout (the runbook): ~/data (the landing zone is ~/data/raw, with its locks beside it),
# ~/dagster_home, ~/dbt_target, ~/secrets (0700: `.env` and `google-key.json`, 0400) and
# ~/config/front-office.env (not secret: FO_BQ_PROJECT=<the project>).

[Unit]
Description=Front Office: Dagster daemon (schedules and runs)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/front-office:current
ContainerName=front-office-daemon
WorkingDir=/dagster_home
Exec=dagster-daemon run -w /app/deploy/workspace.yaml
EnvironmentFile=%h/config/front-office.env
Environment=FO_WAREHOUSE=bigquery
Environment=FO_LANDING_ROOT=/data/raw
Environment=GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-key.json
Volume=%h/data:/data:rw
Volume=%h/dagster_home:/dagster_home:rw
Volume=%h/dbt_target:/app/dbt/target:rw
Volume=%h/secrets/.env:/app/.env:ro
Volume=%h/secrets/google-key.json:/run/secrets/google-key.json:ro
PodmanArgs=--memory=3g
# PID 1 must reap its children: dagster-daemon does not, and a run leaves zombies (spec 0218 *Amendments*).
PodmanArgs=--init

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
